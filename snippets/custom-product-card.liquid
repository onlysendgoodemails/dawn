{% comment %}
  Renders a single product card for sections/custom-product-grid.liquid (Paket 3, see
  plans/startseite.md): image, title, price, and — if the product has a swatch-enabled
  option (native Shopify variant swatches) — a row of small color dots.

  Accepts:
  - product: {Object} Product Liquid object (optional)
  - placeholder_image: {String} placeholder svg name to use when product is blank (optional)

  Usage:
  {% render 'custom-product-card', product: product %}
{% endcomment %}
{%- if product and product != empty -%}
  <a href="{{ product.url }}" class="custom-product-card">
    <span class="custom-product-card__media color-{{ settings.card_color_scheme }}">
      {%- if product.featured_image -%}
        {{
          product.featured_image
          | image_url: width: 600
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 990px) 20vw, (min-width: 750px) 33vw, 50vw',
            widths: '165, 360, 533, 600'
        }}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'custom-product-card__placeholder placeholder-svg' }}
      {%- endif -%}
    </span>
    <div class="custom-product-card__info">
      <span class="custom-product-card__title">{{ product.title }}</span>
      {% render 'price', product: product, price_class: 'custom-product-card__price' %}
      {%- liquid
        assign swatch_option = null
        for option in product.options_with_values
          assign swatch_count = option.values | map: 'swatch' | compact | size
          if swatch_count > 0
            assign swatch_option = option
            break
          endif
        endfor
      -%}
      {%- if swatch_option -%}
        <span class="custom-product-card__swatches">
          {%- for value in swatch_option.values -%}
            {% render 'swatch', swatch: value.swatch %}
          {%- endfor -%}
        </span>
      {%- endif -%}
    </div>
  </a>
{%- else -%}
  <div class="custom-product-card custom-product-card--placeholder">
    <span class="custom-product-card__media color-{{ settings.card_color_scheme }}">
      {{ placeholder_image | default: 'product-apparel-1' | placeholder_svg_tag: 'custom-product-card__placeholder placeholder-svg' }}
    </span>
    <div class="custom-product-card__info">
      <span class="custom-product-card__title">{{ 'onboarding.product_title' | t }}</span>
      {% render 'price', placeholder: true, price_class: 'custom-product-card__price' %}
    </div>
  </div>
{%- endif -%}
