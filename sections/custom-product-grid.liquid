{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-swatch.css' | asset_url | stylesheet_tag }}
{{ 'custom-product-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="custom-product-grid page-width section-{{ section.id }}-padding">
    <div class="custom-product-grid__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="custom-product-grid__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.view_all_label != blank and collection != blank -%}
        <a href="{{ collection.url }}" class="link animate-arrow custom-product-grid__view-all">
          {{- section.settings.view_all_label | escape -}}
          <span class="svg-wrapper"
            ><span class="icon-wrap">&nbsp;{{ 'icon-arrow.svg' | inline_asset_content }}</span></span
          >
        </a>
      {%- endif -%}
    </div>

    <ul class="custom-product-grid__list" role="list">
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: products_to_show -%}
          <li class="custom-product-grid__item">
            {% render 'custom-product-card', product: product %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..products_to_show) -%}
          {%- liquid
            assign ridx = i | modulo: 4 | plus: 1
            assign placeholder_image = 'product-apparel-' | append: ridx
          -%}
          <li class="custom-product-grid__item">
            {% render 'custom-product-card', placeholder_image: placeholder_image %}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Custom Product Grid",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Featured",
      "label": "Heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5,
      "label": "Products to show"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "default": "Shop All",
      "label": "\"View all\" link label",
      "info": "Only shown when a collection is selected."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid"
    }
  ]
}
{% endschema %}
