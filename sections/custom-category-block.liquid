{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-swatch.css' | asset_url | stylesheet_tag }}
{{ 'custom-section-heading.css' | asset_url | stylesheet_tag }}
{{ 'custom-product-grid.css' | asset_url | stylesheet_tag }}
{{ 'custom-category-block.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show
  assign anchor_id = section.settings.anchor_id | handleize
-%}

<div
  {% if anchor_id != blank %}
    id="{{ anchor_id }}"
  {% endif %}
  class="custom-category-block"
>
  <div
    class="custom-category-block__split{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
  >
    <div class="custom-category-block__media media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 750px) 60vw, 100vw',
            widths: '375, 550, 750, 1100, 1500, 1600'
        }}
      {%- else -%}
        {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="custom-category-block__content color-{{ section.settings.color_scheme }} gradient">
      <div class="custom-category-block__content-inner">
        {% render 'custom-section-heading',
          heading: section.settings.heading,
          text: section.settings.text,
          alignment: 'left'
        %}
      </div>
    </div>
  </div>

  <div
    class="custom-category-block__products page-width{% if section.settings.show_divider %} custom-category-block__products--divider{% endif %}"
  >
    <ul class="custom-category-block__list" role="list">
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: products_to_show -%}
          <li class="custom-product-grid__item">
            {% render 'custom-product-card', product: product %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..products_to_show) -%}
          {%- liquid
            assign ridx = i | modulo: 4 | plus: 1
            assign placeholder_image = 'product-apparel-' | append: ridx
          -%}
          <li class="custom-product-grid__item">
            {% render 'custom-product-card', placeholder_image: placeholder_image %}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Custom Category Block",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "default": "shirts",
      "label": "Anchor ID",
      "info": "Target for menu links, e.g. /#shirts. Lowercase letters, numbers and hyphens only."
    },
    {
      "type": "header",
      "content": "Split (text + image)"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Shirts",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Text panel color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Without a collection, placeholder cards are shown."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 8,
      "label": "Products to show",
      "info": "Multiples of 4 fill the desktop rows evenly."
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "default": true,
      "label": "Show divider line below"
    }
  ],
  "presets": [
    {
      "name": "Custom Category Block"
    }
  ]
}
{% endschema %}
