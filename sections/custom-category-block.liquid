{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-swatch.css' | asset_url | stylesheet_tag }}
{{ 'custom-product-grid.css' | asset_url | stylesheet_tag }}
{{ 'custom-category-block.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show
  assign anchor_id = section.settings.anchor_id | handleize
  assign heading_font = section.settings.heading_font
-%}

{%- style -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  .section-{{ section.id }} {
    --category-bg: {{ section.settings.background_color }};
    --category-panel-bg: {{ section.settings.panel_color }};
    --category-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --category-heading-style: {{ heading_font.style }};
    --category-heading-weight: {{ heading_font.weight }};
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
    }
  }
{%- endstyle -%}

<div
  {% if anchor_id != blank %}
    id="{{ anchor_id }}"
  {% endif %}
  class="custom-category-block section-{{ section.id }} custom-category-block--columns-{{ section.settings.columns_desktop }}"
>
  <div class="custom-category-block__inner page-width">
    <div
      class="custom-category-block__split{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
    >
      <div class="custom-category-block__content">
        <div class="custom-category-block__content-inner">
          {%- if section.settings.heading != blank -%}
            <h2 class="custom-category-block__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="custom-category-block__text">{{ section.settings.text }}</div>
          {%- endif -%}
        </div>
      </div>
      <div
        class="custom-category-block__media media"
        {% if section.settings.image != blank %}
          style="--image-focal: {{ section.settings.image.presentation.focal_point }}"
        {% endif %}
      >
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 750px) 50vw, 165vw',
              widths: '375, 550, 750, 1100, 1400'
          }}
        {%- else -%}
          {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>

    {%- liquid
      comment
        Tiles are placed by product number. product_total is the number of cards actually
        rendered, so a tile can never end up behind a product that does not exist.
      endcomment
      if collection != blank and collection.products.size > 0
        assign product_total = collection.products.size
        if product_total > products_to_show
          assign product_total = products_to_show
        endif
      else
        assign product_total = products_to_show
      endif
      assign tile_slots = section.blocks.size | plus: 1.0
    -%}
    <ul class="custom-category-block__list" role="list">
      {%- for i in (1..product_total) -%}
        <li class="custom-product-grid__item">
          {%- if collection != blank and collection.products.size > 0 -%}
            {% render 'custom-product-card', product: collection.products[forloop.index0] %}
          {%- else -%}
            {%- assign ridx = i | modulo: 4 | plus: 1 -%}
            {%- assign placeholder_image = 'product-apparel-' | append: ridx -%}
            {% render 'custom-product-card', placeholder_image: placeholder_image %}
          {%- endif -%}
        </li>
        {%- for block in section.blocks -%}
          {%- liquid
            assign target = block.settings.position
            if target == 0
              assign target = forloop.index | times: product_total | divided_by: tile_slots | round
            endif
            if target < 1
              assign target = 1
            endif
            if target > product_total
              assign target = product_total
            endif
          -%}
          {%- if target == i -%}
            {%- liquid
              assign tile_label = block.settings.label | default: block.settings.image.alt
              assign tile_image = block.settings.image
            -%}
            <li
              class="custom-category-block__tile custom-category-block__tile--cols-{{ block.settings.columns }} custom-category-block__tile--rows-{{ block.settings.rows }}"
              {{ block.shopify_attributes }}
            >
              <{% if block.settings.link != blank %}a href="{{ block.settings.link }}"{% else %}div{% endif %}
                class="custom-category-block__tile-link media"
                {% if tile_label != blank %}aria-label="{{ tile_label | escape }}"{% endif %}
                {% if tile_image != blank %}style="--image-focal: {{ tile_image.presentation.focal_point }}"{% endif %}
              >
                {%- if tile_image != blank -%}
                  {{
                    tile_image
                    | image_url: width: 1500
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 990px) 50vw, 100vw',
                      widths: '375, 550, 750, 1100, 1500',
                      alt: tile_label
                  }}
                {%- else -%}
                  {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </{% if block.settings.link != blank %}a{% else %}div{% endif %}>
            </li>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Custom Category Block",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "default": "shirts",
      "label": "Anchor ID",
      "info": "Target for menu links, e.g. /#shirts. Lowercase letters, numbers and hyphens only."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "info": "Space above the image. Use it on the first block to separate it from the trust bar.",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors & font"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f6f2"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Text panel",
      "default": "#e5e8e5"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "lora_n4"
    },
    {
      "type": "header",
      "content": "Image + text"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Shirts",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Mobile shows a 4:5 portrait with the text laid over the bottom left, desktop a landscape crop next to the text panel. Set the focal point so the subject stays in view."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Without a collection, placeholder cards are shown."
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "4"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "image_tile",
      "name": "Image tile",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Portrait or square. Set the focal point so the subject stays in view when the tile is cropped."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional. Without a link the tile is just an image."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Link label (accessibility)",
          "info": "Read out by screen readers, e.g. \"Shop the new polos\". Falls back to the image's alt text."
        },
        {
          "type": "range",
          "id": "position",
          "min": 0,
          "max": 12,
          "step": 1,
          "label": "After product no.",
          "info": "0 = automatic: tiles are spread evenly between the products, in block order. A number places the tile right after that product (capped at the last product).",
          "default": 0
        },
        {
          "type": "select",
          "id": "columns",
          "label": "Width",
          "options": [
            { "value": "1", "label": "1 column (same width as a product)" },
            { "value": "2", "label": "2 columns" }
          ],
          "default": "1"
        },
        {
          "type": "select",
          "id": "rows",
          "label": "Height",
          "options": [
            { "value": "1", "label": "1 row (same height as a product)" },
            { "value": "2", "label": "2 rows (tall portrait)" }
          ],
          "default": "1"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Category Block"
    }
  ]
}
{% endschema %}
