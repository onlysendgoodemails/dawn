{{ 'custom-section-heading.css' | asset_url | stylesheet_tag }}
{{ 'custom-image-text.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign image = section.settings.image
  assign ratio = section.settings.image_ratio
  if ratio == 'adapt' and image != blank
    assign ratio_value = image.aspect_ratio
  elsif ratio == 'square'
    assign ratio_value = 1.0
  elsif ratio == 'landscape'
    assign ratio_value = 1.5
  else
    assign ratio_value = 0.8
  endif
-%}
<div
  class="custom-image-text__wrapper{% if section.settings.layout == 'contained' %} page-width custom-image-text__wrapper--contained{% endif %}"
>
<div
  class="custom-image-text color-{{ section.settings.color_scheme }} gradient{% if section.settings.image_position == 'right' %} custom-image-text--image-right{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
  style="--image-ratio: {{ ratio_value }}; --image-focus: {{ section.settings.image_focus }};"
>
  <div class="custom-image-text__media media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1600
        | image_tag:
          loading: 'lazy',
          sizes: '(min-width: 750px) 60vw, 100vw',
          widths: '375, 550, 750, 1100, 1500, 1600'
      }}
    {%- else -%}
      {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="custom-image-text__content">
    <div class="custom-image-text__content-inner">
      {% render 'custom-section-heading',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        text: section.settings.text,
        alignment: 'left'
      %}
      {%- if section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
          class="button button--primary custom-image-text__button"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>
</div>

{% schema %}
{
  "name": "Custom Image + Text",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "info": "Portrait (4:5) suits most fashion shots, square works for detail angles. \"Adapt to image\" never crops.",
      "options": [
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (3:2)" },
        { "value": "adapt", "label": "Adapt to image" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "image_focus",
      "label": "Image focus",
      "info": "Which part of the image stays visible if it gets cropped on a different screen size.",
      "options": [
        { "value": "50% 0%", "label": "Top" },
        { "value": "50% 30%", "label": "Upper middle" },
        { "value": "50% 50%", "label": "Center" },
        { "value": "50% 100%", "label": "Bottom" }
      ],
      "default": "50% 30%"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "contained", "label": "Contained (with side margins)" },
        { "value": "full", "label": "Full width (edge to edge)" }
      ],
      "default": "contained"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "info": "Use a light scheme (e.g. Glacier Mist) or a dark scheme (e.g. Fjord Navy) — the button color adapts automatically.",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "default": "Lorem Ipsum",
      "label": "Eyebrow",
      "info": "Optional. Leave blank to omit — e.g. for a shorter promo banner without an eyebrow."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Lorem ipsum dolor sit amet.",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>",
      "label": "Text",
      "info": "Optional. Leave blank for a compact banner with only a heading and button."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Custom Image + Text"
    }
  ]
}
{% endschema %}
