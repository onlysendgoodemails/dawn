{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{{ 'custom-footer.css' | asset_url | stylesheet_tag }}
{{ 'https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap' | stylesheet_tag }}

{%- liquid
  assign has_social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign has_social_icons = false
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<footer class="custom-footer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width custom-footer__top">
    <div class="custom-footer__brand">
      {%- if settings.logo != blank -%}
        {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
        <a href="{{ routes.root_url }}" class="custom-footer__logo-link link link--text">
          {{
            settings.logo
            | image_url: width: 300
            | image_tag: class: 'custom-footer__logo', height: logo_height, width: settings.logo_width, alt: shop.name
          }}
        </a>
      {%- else -%}
        <a href="{{ routes.root_url }}" class="custom-footer__brand-name link link--text">{{ shop.name }}</a>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="custom-footer__brand-text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if has_social_icons -%}
        {%- render 'social-icons', class: 'custom-footer__social' -%}
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      <div class="custom-footer__column" {{ block.shopify_attributes }}>
        {%- if block.settings.heading != blank -%}
          <h2 class="custom-footer__column-heading">{{ block.settings.heading }}</h2>
        {%- endif -%}
        {%- if block.settings.menu != blank -%}
          <ul class="custom-footer__links list-unstyled">
            {%- for link in block.settings.menu.links -%}
              <li>
                <a
                  href="{{ link.url }}"
                  class="link link--text custom-footer__link{% if link.active %} custom-footer__link--active{% endif %}"
                >
                  {{ link.title | escape }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="page-width custom-footer__wordmark">
    {%- liquid
      assign wordmark_words = section.settings.wordmark_text | upcase | split: ' '
      assign wordmark_line_1 = wordmark_words | first
      assign wordmark_line_2 = wordmark_words | slice: 1, 10 | join: ' '
      assign wordmark_clip_id = 'custom-footer-wordmark-' | append: section.id
      assign wordmark_image_url = 'https://cdn.shopify.com/s/files/1/0888/1186/4401/files/LandOfLinks.png?v=1733215608'
      if section.settings.wordmark_image != blank
        assign wordmark_image_url = section.settings.wordmark_image | image_url: width: 2000
      endif
    -%}
    <svg
      class="custom-footer__wordmark-svg"
      viewBox="0 0 1000 340"
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label="{{ section.settings.wordmark_text | escape }}"
    >
      <defs>
        <clipPath id="{{ wordmark_clip_id }}">
          <text x="0" y="85" dominant-baseline="central" textLength="1000" lengthAdjust="spacingAndGlyphs"
            >{{- wordmark_line_1 -}}</text
          >
          {%- if wordmark_line_2 != blank -%}
            <text x="0" y="255" dominant-baseline="central">{{- wordmark_line_2 -}}</text>
          {%- endif -%}
        </clipPath>
      </defs>
      <image
        href="{{ wordmark_image_url }}"
        width="1000"
        height="340"
        preserveAspectRatio="xMidYMid slice"
        clip-path="url(#{{ wordmark_clip_id }})"
      />
    </svg>
  </div>

  <div class="page-width custom-footer__bottom">
    <small class="custom-footer__copyright"
      >&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}. All rights reserved.</small
    >
    <div class="custom-footer__legal-group">
      {%- liquid
        assign privacy_url = section.settings.privacy_link_url | default: shop.privacy_policy.url
        assign terms_url = section.settings.terms_link_url | default: shop.terms_of_service.url
      -%}
      <ul class="custom-footer__legal list-unstyled">
        {%- if privacy_url != blank -%}
          <li><a href="{{ privacy_url }}" class="link link--text">Datenschutz</a></li>
        {%- endif -%}
        {%- if section.settings.cookies_link_url != blank -%}
          <li><a href="{{ section.settings.cookies_link_url }}" class="link link--text">Cookies</a></li>
        {%- endif -%}
        {%- if terms_url != blank -%}
          <li><a href="{{ terms_url }}" class="link link--text">AGB</a></li>
        {%- endif -%}
        {%- if section.settings.imprint_link_url != blank -%}
          <li><a href="{{ section.settings.imprint_link_url }}" class="link link--text">Impressum</a></li>
        {%- endif -%}
      </ul>
      {%- if section.settings.cancellation_link_url != blank -%}
        <a href="{{ section.settings.cancellation_link_url }}" class="custom-footer__cancel-button">
          {{ section.settings.cancellation_link_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Custom Footer",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.</p>",
      "label": "Description",
      "info": "Logo/name comes from Theme settings → Logo (falls back to the shop name). Social icons come from Theme settings → Social media."
    },
    {
      "type": "header",
      "content": "Giant wordmark"
    },
    {
      "type": "text",
      "id": "wordmark_text",
      "label": "Wordmark text",
      "default": "Northern Links",
      "info": "Fixed brand lettering, independent of the shop name in Shopify's admin settings."
    },
    {
      "type": "image_picker",
      "id": "wordmark_image",
      "label": "Texture image",
      "info": "Shown through the giant two-line lettering above the copyright row. Leave empty to use the default \"Land of Links\" photo."
    },
    {
      "type": "header",
      "content": "Legal",
      "info": "Jeder Link erscheint erst, sobald eine URL hinterlegt ist. Datenschutz/AGB fallen ohne eigene URL automatisch auf die Shopify-Richtlinien zurück (Einstellungen → Richtlinien)."
    },
    {
      "type": "url",
      "id": "privacy_link_url",
      "label": "Datenschutz – URL",
      "info": "Leer lassen, um automatisch shop.privacy_policy zu verwenden."
    },
    {
      "type": "url",
      "id": "cookies_link_url",
      "label": "Cookies – URL"
    },
    {
      "type": "url",
      "id": "terms_link_url",
      "label": "AGB – URL",
      "info": "Leer lassen, um automatisch shop.terms_of_service zu verwenden."
    },
    {
      "type": "url",
      "id": "imprint_link_url",
      "label": "Impressum – URL"
    },
    {
      "type": "text",
      "id": "cancellation_link_label",
      "label": "Ghost-Button Label",
      "default": "Bestellung widerrufen",
      "info": "EU/German requirement (§ 312k BGB) for cancellable contracts. Only shown once a link is set below."
    },
    {
      "type": "url",
      "id": "cancellation_link_url",
      "label": "Ghost-Button URL"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Column"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Custom Footer",
      "blocks": [
        {
          "type": "link_list",
          "settings": {
            "heading": "Shop"
          }
        },
        {
          "type": "link_list",
          "settings": {
            "heading": "About"
          }
        },
        {
          "type": "link_list",
          "settings": {
            "heading": "Help"
          }
        }
      ]
    }
  ]
}
{% endschema %}
