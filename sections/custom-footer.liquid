{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'custom-footer.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Lesebreite für Richtlinien und Textseiten. Der Footer steht auf jeder Seite, deshalb wird das Stylesheet hier geladen.
{%- endcomment -%}
{{ 'custom-text-pages.css' | asset_url | stylesheet_tag }}
{{ 'https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap' | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<footer class="custom-footer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width custom-footer__top">
    {%- for block in section.blocks -%}
      <div
        class="custom-footer__column{% if block.type == 'newsletter' %} custom-footer__column--newsletter{% endif %}"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.heading != blank -%}
          <h2 class="custom-footer__column-heading">{{ block.settings.heading }}</h2>
        {%- endif -%}
        {%- if block.type == 'payment' -%}
          {%- comment -%}
            Zahlungsarten: die in Shopify aktivierten Zahlarten, dezent in Graustufen.
          {%- endcomment -%}
          {%- if shop.enabled_payment_types.size > 0 -%}
            <ul class="custom-footer__payment list-unstyled" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="custom-footer__payment-item">
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        {%- elsif block.type == 'newsletter' -%}
          {%- comment -%}
            Kleine Newsletter-Anmeldung. Läuft wie der große Block auf der Startseite über das Shopify-Kundenformular.
            Sobald Klaviyo angebunden ist, muss dieses Formular (und das auf der Startseite) dorthin zeigen.
          {%- endcomment -%}
          {% form 'customer', id: 'ContactFooter', class: 'custom-footer__newsletter newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if block.settings.text != blank -%}
              <p class="custom-footer__newsletter-text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
            <div class="custom-footer__newsletter-field">
              <label class="visually-hidden" for="FooterNewsletterEmail-{{ block.id }}">{{ 'newsletter.label' | t }}</label>
              <input
                id="FooterNewsletterEmail-{{ block.id }}"
                type="email"
                name="contact[email]"
                class="custom-footer__newsletter-input"
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="{{ 'newsletter.label' | t }}"
                required
                {%- if form.errors %}
                  aria-invalid="true"
                  aria-describedby="FooterNewsletterError-{{ block.id }}"
                {%- elsif form.posted_successfully? %}
                  aria-describedby="FooterNewsletterSuccess-{{ block.id }}"
                {%- endif %}
              >
              <button
                type="submit"
                class="custom-footer__newsletter-button"
                name="commit"
                aria-label="{{ 'newsletter.button_label' | t }}"
              >
                <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
              </button>
            </div>
            {%- if shop.privacy_policy != blank -%}
              <p class="custom-footer__newsletter-disclaimer">
                {{ 'sections.custom-newsletter.privacy_disclaimer_html' | t: link: shop.privacy_policy.url }}
              </p>
            {%- endif -%}
            {%- if form.errors -%}
              <p class="custom-footer__newsletter-message" id="FooterNewsletterError-{{ block.id }}" role="alert">
                {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
              </p>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <p
                class="custom-footer__newsletter-message"
                id="FooterNewsletterSuccess-{{ block.id }}"
                role="status"
                tabindex="-1"
              >
                {{- 'newsletter.success' | t -}}
              </p>
            {%- endif -%}
          {% endform %}
        {%- elsif block.settings.menu != blank -%}
          <ul class="custom-footer__links list-unstyled">
            {%- for link in block.settings.menu.links -%}
              <li>
                <a
                  href="{{ link.url }}"
                  class="link link--text custom-footer__link{% if link.active %} custom-footer__link--active{% endif %}"
                >
                  {{ link.title | escape }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="page-width custom-footer__wordmark">
    {%- liquid
      assign wordmark_words = section.settings.wordmark_text | upcase | split: ' '
      assign wordmark_line_1 = wordmark_words | first
      assign wordmark_line_2 = wordmark_words | slice: 1, 10 | join: ' '
      assign wordmark_clip_id = 'custom-footer-wordmark-' | append: section.id
      assign wordmark_image_url = 'https://cdn.shopify.com/s/files/1/0888/1186/4401/files/LandOfLinks.png?v=1733215608'
      if section.settings.wordmark_image != blank
        assign wordmark_image_url = section.settings.wordmark_image | image_url: width: 2000
      endif
    -%}
    <svg
      class="custom-footer__wordmark-svg"
      viewBox="0 0 1000 340"
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label="{{ section.settings.wordmark_text | escape }}"
    >
      <defs>
        <clipPath id="{{ wordmark_clip_id }}">
          <text x="0" y="85" dominant-baseline="central" textLength="1000" lengthAdjust="spacingAndGlyphs"
            >{{- wordmark_line_1 -}}</text
          >
          {%- if wordmark_line_2 != blank -%}
            <text x="0" y="255" dominant-baseline="central">{{- wordmark_line_2 -}}</text>
          {%- endif -%}
        </clipPath>
      </defs>
      <image
        href="{{ wordmark_image_url }}"
        width="1000"
        height="340"
        preserveAspectRatio="xMidYMin slice"
        clip-path="url(#{{ wordmark_clip_id }})"
      />
    </svg>
  </div>

  <div class="page-width custom-footer__bottom">
    <small class="custom-footer__copyright"
      >&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}. All rights reserved.</small
    >
    <div class="custom-footer__legal-group">
      {%- liquid
        assign privacy_url = section.settings.privacy_link_url | default: shop.privacy_policy.url
        assign terms_url = section.settings.terms_link_url | default: shop.terms_of_service.url
        assign refund_url = section.settings.refund_link_url | default: shop.refund_policy.url
      -%}
      {%- comment -%}
        Reihenfolge (Henrik, 2026-10-11): Impressum, Datenschutz, Cookies, AGB, Widerrufsbelehrung.
      {%- endcomment -%}
      <ul class="custom-footer__legal list-unstyled">
        {%- if section.settings.imprint_link_url != blank -%}
          <li><a href="{{ section.settings.imprint_link_url }}" class="link link--text">Impressum</a></li>
        {%- endif -%}
        {%- if privacy_url != blank -%}
          <li><a href="{{ privacy_url }}" class="link link--text">Datenschutz</a></li>
        {%- endif -%}
        {%- if section.settings.cookies_link_url != blank -%}
          <li><a href="{{ section.settings.cookies_link_url }}" class="link link--text">Cookies</a></li>
        {%- endif -%}
        {%- if terms_url != blank -%}
          <li><a href="{{ terms_url }}" class="link link--text">AGB</a></li>
        {%- endif -%}
        {%- if refund_url != blank -%}
          <li><a href="{{ refund_url }}" class="link link--text">Widerrufsbelehrung</a></li>
        {%- endif -%}
      </ul>
      {%- if section.settings.cancellation_link_url != blank -%}
        <a href="{{ section.settings.cancellation_link_url }}" class="custom-footer__cancel-button">
          {{ section.settings.cancellation_link_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Custom Footer",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Giant wordmark"
    },
    {
      "type": "text",
      "id": "wordmark_text",
      "label": "Wordmark text",
      "default": "Northern Links",
      "info": "Fixed brand lettering, independent of the shop name in Shopify's admin settings."
    },
    {
      "type": "image_picker",
      "id": "wordmark_image",
      "label": "Texture image",
      "info": "Shown through the giant two-line lettering above the copyright row. Leave empty to use the default \"Land of Links\" photo."
    },
    {
      "type": "header",
      "content": "Legal",
      "info": "Jeder Link erscheint erst, sobald eine URL hinterlegt ist. Datenschutz/AGB fallen ohne eigene URL automatisch auf die Shopify-Richtlinien zurück (Einstellungen → Richtlinien)."
    },
    {
      "type": "url",
      "id": "privacy_link_url",
      "label": "Datenschutz – URL",
      "info": "Leer lassen, um automatisch shop.privacy_policy zu verwenden."
    },
    {
      "type": "url",
      "id": "cookies_link_url",
      "label": "Cookies – URL"
    },
    {
      "type": "url",
      "id": "terms_link_url",
      "label": "AGB – URL",
      "info": "Leer lassen, um automatisch shop.terms_of_service zu verwenden."
    },
    {
      "type": "url",
      "id": "imprint_link_url",
      "label": "Impressum – URL",
      "info": "Shopify-Richtlinie Impressum: /policies/legal-notice"
    },
    {
      "type": "url",
      "id": "refund_link_url",
      "label": "Widerrufsbelehrung – URL",
      "info": "Leer lassen, um automatisch shop.refund_policy (Rückerstattungsrichtlinie) zu verwenden."
    },
    {
      "type": "text",
      "id": "cancellation_link_label",
      "label": "Ghost-Button Label",
      "default": "Vertrag widerrufen",
      "info": "Widerrufsfunktion nach § 356a BGB (gesetzlich seit 19.06.2026 nötig). Muss auf eine Seite führen, auf der Verbraucher ohne Login den Widerruf erklären können. Erscheint erst, sobald unten eine URL gesetzt ist."
    },
    {
      "type": "url",
      "id": "cancellation_link_url",
      "label": "Ghost-Button URL"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Column"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter sign-up",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Small sign-up form. Uses the Shopify customer form like the large block on the home page. Once Klaviyo is connected, both must post there."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Newsletter"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Short text (optional)"
        }
      ]
    },
    {
      "type": "payment",
      "name": "Payment methods",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows the payment methods enabled in Shopify (Settings > Payments) as small grey icons."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Zahlung"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Custom Footer",
      "blocks": [
        {
          "type": "link_list",
          "settings": {
            "heading": "Shop"
          }
        },
        {
          "type": "link_list",
          "settings": {
            "heading": "Support"
          }
        },
        {
          "type": "payment",
          "settings": {
            "heading": "Zahlung"
          }
        },
        {
          "type": "newsletter",
          "settings": {
            "heading": "Newsletter"
          }
        }
      ]
    }
  ]
}
{% endschema %}
