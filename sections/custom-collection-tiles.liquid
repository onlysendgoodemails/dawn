{{ 'custom-section-heading.css' | asset_url | stylesheet_tag }}
{{ 'custom-collection-tiles.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_font = section.settings.heading_font
  assign placeholders = 'hero-apparel-1,hero-apparel-2,detailed-apparel-1' | split: ','
-%}

{%- style -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  .section-{{ section.id }} {
    --tiles-count: {{ section.blocks.size }};
    --tile-ratio-desktop: {{ section.settings.desktop_ratio }};
    --tile-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --tile-heading-style: {{ heading_font.style }};
    --tile-heading-weight: {{ heading_font.weight }};
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="custom-collection-tiles section-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <div class="custom-collection-tiles__heading page-width">
        {% render 'custom-section-heading',
          heading: section.settings.heading,
          alignment: 'left'
        %}
      </div>
    {%- endif -%}

    <div
      class="custom-collection-tiles__inner{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
    >
      <ul class="custom-collection-tiles__list" role="list">
        {%- for block in section.blocks -%}
          <li class="custom-collection-tiles__item" {{ block.shopify_attributes }}>
            <div class="custom-collection-tiles__media media">
              {%- if block.settings.image != blank -%}
                {%- assign focal_style = 'object-position: ' | append: block.settings.image.presentation.focal_point -%}
                {{
                  block.settings.image
                  | image_url: width: 1100
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 750px) 33vw, 78vw',
                    widths: '375, 550, 750, 1100',
                    style: focal_style
                }}
              {%- else -%}
                {%- assign placeholder_index = forloop.index0 | modulo: 3 -%}
                {%- assign placeholder_name = placeholders[placeholder_index] -%}
                {{ placeholder_name | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="custom-collection-tiles__content">
              {%- if block.settings.heading != blank -%}
                <h3 class="custom-collection-tiles__title">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a
                  {% if block.settings.link == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.link }}"
                  {% endif %}
                  class="custom-collection-tiles__button"
                >
                  {{- block.settings.button_label | escape -}}
                </a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Collection Tiles",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "2–4 image tiles with a button. Mobile: swipeable row with the next tile peeking in. Desktop: all tiles side by side."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Heading & font"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Section heading",
      "info": "Optional. Leave empty for tiles without a heading."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Tile heading font",
      "default": "lora_n4"
    },
    {
      "type": "header",
      "content": "Tiles"
    },
    {
      "type": "select",
      "id": "desktop_ratio",
      "label": "Image ratio on desktop",
      "info": "Mobile is always 4:5.",
      "options": [
        { "value": "4 / 5", "label": "4:5 portrait" },
        { "value": "1 / 1", "label": "1:1 square" },
        { "value": "5 / 4", "label": "5:4 landscape" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Shown as 4:5 portrait on mobile. Set the focal point so the subject stays in view."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Story"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "The whole tile is clickable."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Custom Collection Tiles",
      "blocks": [
        { "type": "tile", "settings": { "heading": "Story", "button_label": "Discover" } },
        { "type": "tile", "settings": { "heading": "Lookbook", "button_label": "View" } },
        { "type": "tile", "settings": { "heading": "Details", "button_label": "Shop" } }
      ]
    }
  ]
}
{% endschema %}
